PAYCHEX_CLIENT_ID=
PAYCHEX_CLIENT_SECRET=
PAYCHEX_COMPANY_ID=
PAYCHEX_BASE_URL=https://api.paychex.com
PAYCHEX_REGULAR_COMPONENT_ID=
PAYCHEX_OT_COMPONENT_ID=
PAYCHEX_PTO_COMPONENT_ID=
PAYCHEX_REIMBURSE_COMPONENT_ID=

# 8-character Paychex client code from Flex dashboard (top-left)
# NOT the UUID used for API calls
PAYCHEX_CLIENT_CODE=

# Exact pay component names as they appear in Paychex Flex
# Pay Items > Payroll section. Case-sensitive. Must match exactly.
PAYCHEX_REGULAR_COMPONENT_NAME=Regular
PAYCHEX_OT_COMPONENT_NAME=Overtime
PAYCHEX_PTO_COMPONENT_NAME=PTO
PAYCHEX_REIMBURSE_COMPONENT_NAME=Reimbursement

DATABASE_URL=postgresql://user:pass@host:5432/payroll_db
JWT_SECRET=
PORT=3000
NODE_ENV=development
ADMIN_EMAIL=
