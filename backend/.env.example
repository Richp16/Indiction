# Copy to backend/.env. That file is gitignored.
# Never put these values in frontend files. Vite variables are public in the browser.

# --- Required ---

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode reserved characters in the password (@ : / # ?).
DATABASE_URL=postgresql://indiction_app:replace-me@localhost:5432/indiction

# false for a normal local PostgreSQL install.
# require for hosted Postgres when the provider uses TLS (certificate is not verified).
# verify-full plus DATABASE_SSL_CA when the host gives you a CA file.
# If DATABASE_SSL is unset, sslmode=require in DATABASE_URL still turns TLS on.
DATABASE_SSL=false
# DATABASE_SSL_CA=

# Private signing secret for login tokens. Not a Paychex value and not a JWT.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Common ---

PORT=3000

# Extra browser origin allowed to call the API, besides http://localhost:5173.
# Example: https://payroll.example.com
FRONTEND_ORIGIN=

# Leave empty to follow Company Settings / the setup wizard.
# 0, false, no, or off forces Non-Paychex and overrides the UI.
# Any other non-empty value, including 1 or true, forces Paychex mode.
PAYCHEX_ENABLED=

# --- Paychex (required only for Paychex mode) ---

# sandbox or production. Default production.
PAYCHEX_ENV=sandbox
PAYCHEX_CLIENT_ID=
PAYCHEX_CLIENT_SECRET=

# API company id from the Paychex developer app (not the SPI numeric Company ID).
PAYCHEX_COMPANY_ID=

# --- Paychex optional ---

# Overrides PAYCHEX_ENV when set. No trailing slash.
PAYCHEX_BASE_URL=

# Numeric Company ID written on SPI import rows. PAYCHEX_SPI_COMPANY_ID is an alias.
PAYCHEX_CLIENT_CODE=
PAYCHEX_SPI_COMPANY_ID=

# Pay component ids. Find them with GET /api/paychex/paycomponents after sync.
# Required only when submitting or exporting hours that map to these components.
PAYCHEX_REGULAR_COMPONENT_ID=
PAYCHEX_OT_COMPONENT_ID=
PAYCHEX_PTO_COMPONENT_ID=
PAYCHEX_REIMBURSE_COMPONENT_ID=

# Comma-separated ids for recurring reimbursement sync.
# When empty, PAYCHEX_REIMBURSE_COMPONENT_ID is used, then component-name matching.
PAYCHEX_REIMBURSEMENT_COMPONENT_IDS=
